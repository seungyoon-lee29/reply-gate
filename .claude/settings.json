{
  "env": {
    "HANDOFF_FILE": ".dryforge/handoff.md"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-live-reports.sh\"",
            "timeout": 10,
            "statusMessage": "라이브 리포트 불변식 확인"
          }
        ]
      }
    ]
  }
}
