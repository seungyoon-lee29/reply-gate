# Reply-Gate 환경 변수 예시 — 키 이름만 담는다. 실제 값은 .env 에만 두고 절대 커밋하지 않는다.
# 사용법: cp .env.example .env  → 값 채우기

# ── 외부 API 키 ─────────────────────────────────────────────────────────────
# 생성(의도 해석·초안 생성·SQL 생성)과 임베딩에 공통으로 쓴다.
OPENAI_API_KEY=
# L2 판정(Anthropic)에 쓴다.
ANTHROPIC_API_KEY=

# ── 로컬 Docker Postgres (docker compose 와 애플리케이션이 같은 값을 읽는다) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=reply_gate
# 컨테이너 superuser — 스키마/계정 생성용
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
# 애플리케이션 계정 (읽기/쓰기)
POSTGRES_APP_USER=reply_gate_app
POSTGRES_APP_PASSWORD=
# text-to-SQL 실행 전용 계정 (SELECT 만)
POSTGRES_RO_USER=reply_gate_ro
POSTGRES_RO_PASSWORD=

# ── 조정 가능 기본값 (비워두면 코드 기본값 사용) ────────────────────────────
# GENERATION_MODEL=gpt-5.6-terra
# BULK_GENERATION_MODEL=gpt-5.6-sol
# GENERATION_EFFORT=
# EMBEDDING_MODEL=text-embedding-3-small
# L2_ENABLED=true
# JUDGE_MODEL=claude-sonnet-5
# JUDGE_EFFORT=
# JUDGE_MAX_OUTPUT_TOKENS=16000
# EMBEDDING_DIMENSIONS=1536
# RERANK_MODEL=gpt-5.6-luna
# 판정 고정 프리픽스 캐싱 — 실측했으나 미채택이라 기본은 꺼짐 (결정 0019)
# JUDGE_PROMPT_CACHING_ENABLED=false
# 검색용 질의 재작성 — 기본 켜짐. 끄려면 명시해야 한다
# QUERY_REWRITE_ENABLED=true
# VECTOR_TOP_K=5
# VECTOR_SIMILARITY_THRESHOLD=0.3
# 질의 단위 기권 게이트 (결정 0014) — 기본 켜짐.
# tau 는 임베딩 모델에 묶인 조건 종속 인자다. EMBEDDING_MODEL 을 바꿔도 따라오지 않는다.
# ABSTENTION_GATE_ENABLED=true
# ABSTENTION_GATE_STATISTIC=rank1_minus_rank_k_spread
# ABSTENTION_TAU=0.06
# SQL_MAX_ROWS=50
# SQL_STATEMENT_TIMEOUT_MS=5000
